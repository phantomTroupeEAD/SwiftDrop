# ==========================================
# SwiftDrop Core API — Environment Config
# ==========================================

# Server & Runtime
PORT=8080
APP_ENV=local

# Security & JWT
JWT_SECRET=swiftdrop-development-secret-key-change-in-production-32chars

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/swiftdrop?sslmode=disable

# ----------------------------------------------------
# SMTP Mail Server Configuration (Optional for Local Dev)
# ----------------------------------------------------
# If SMTP_HOST is left empty or commented out, the API automatically
# uses DevEmailSender (prints the 6-digit OTP code to the console).
# When you are ready to send real emails, uncomment and fill in:
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=no-reply@swiftdrop.com

# ----------------------------------------------------
# Google OAuth 2.0 Configuration (Optional for Local Dev)
# ----------------------------------------------------
# If GOOGLE_CLIENT_ID is empty, the API automatically accepts mock ID tokens
# (e.g. mock_google_id_token_alice or mock_user@example.com) for offline testing.
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

