# ==============================================================================
# SwiftDrop Local Stack Overrides (deploy/.env.example)
# Owner: Member 9 (DevOps, Kubernetes & Database Coordinator)
# Authority: docs/operations/environment-variables.md & SRS §11.1-11.3
#
# Optional. `make up` works without it (the values below are the Compose defaults).
# To change a value: cp deploy/.env.example deploy/.env, then edit deploy/.env
# (gitignored). Compose reads .env from this deploy/ folder, NOT the repo root.
#
# Only the variables deploy/docker-compose.yml substitutes belong here.
# Per-service templates stay in each service folder (services/ai-assistant/,
# services/messaging/) for running one service on its own.
# Kubernetes never reads .env files: it uses ConfigMaps and Secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime
# ------------------------------------------------------------------------------
APP_ENV=local
# core-api, outbox-relay and event-worker only (the AI service is fixed to "info")
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. PostgreSQL 16
# Applied only when the volume is first created. After a change: make reset
# ------------------------------------------------------------------------------
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=swiftdrop_dev_password
POSTGRES_DB=swiftdrop_db

# ------------------------------------------------------------------------------
# 3. RabbitMQ 3.13
# RABBITMQ_URL must use the same user and password as the two lines above it
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=swiftdrop
RABBITMQ_DEFAULT_PASS=swiftdrop_dev
RABBITMQ_URL=amqp://swiftdrop:swiftdrop_dev@rabbitmq:5672/

# ------------------------------------------------------------------------------
# 4. Shared keys (local-only placeholders; real values live in Kubernetes Secrets)
# ------------------------------------------------------------------------------
# Used by core-api and the ai-assistant (both must have the same value)
JWT_SECRET=swiftdrop-development-secret-key-change-in-production-32chars
# Webhook secret encryption: ONE 32-byte AES-256-GCM key, written in two encodings
# because core-api and the messaging worker parse it differently. Both lines must
# describe the SAME 32 bytes or the worker cannot decrypt what core-api stored.
#   core-api:      base64 of 32 bytes   (openssl rand -base64 32)
#   event-worker:  64 hex characters    (the same bytes: echo <base64> | base64 -d | xxd -p -c 64)
# Placeholder below = the ASCII string 01234567890123456789012345678901 (local only).
WEBHOOK_SECRET_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
WEBHOOK_SECRET_ENCRYPTION_KEY_HEX=3031323334353637383930313233343536373839303132333435363738393031
MERCHANT_API_KEY_PEPPER=swiftdrop-merchant-pepper-secret-32-chars

# ------------------------------------------------------------------------------
# 5. MinIO (local S3 for proof-of-delivery files; also used as core-api's S3 keys)
# ------------------------------------------------------------------------------
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
