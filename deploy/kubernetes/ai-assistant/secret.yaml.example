apiVersion: v1
kind: Secret
metadata:
  name: ai-assistant-secrets
  namespace: swiftdrop
  labels:
    app.kubernetes.io/name: ai-assistant
    app.kubernetes.io/part-of: swiftdrop
    app.kubernetes.io/component: ai-service
    app.kubernetes.io/managed-by: member-10
type: Opaque
stringData:
  # Sensitive API keys and internal service tokens
  # Replace with production values before applying to cluster
  LLM_API_KEY: "sk-or-v1-production-llm-secret-token"
  SWIFTDROP_API_KEY: "sd_live_prod_merchant_default_secret_key"
  AI_SERVICE_ROLE_TOKEN: "internal-cluster-service-shared-secret-123"
  # Note: JWT_SECRET is loaded from core-api-secrets in deployment.yaml to ensure shared HMAC-SHA256 signature alignment.
  # If overriding locally in ai-assistant-secrets instead, provide:
  # JWT_SECRET: "swiftdrop-production-jwt-secret-replace-in-cluster"
