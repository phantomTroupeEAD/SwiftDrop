# Member 4 merchants slice — LOCAL configuration template.
# ./scripts/up.sh copies this to .env and fills the two GENERATE values with random data.
# Never commit .env. Real environments get secrets from Kubernetes Secrets (Member 9).

APP_ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=info
DATABASE_URL=postgres://swiftdrop:swiftdrop_dev@postgres:5432/swiftdrop_db?sslmode=disable

# Member 1 stand-in: tokens are made by cmd/devtoken with ../.dev/jwt_private.pem
JWT_ISSUER=http://localhost
JWT_PUBLIC_KEY_PEM=/run/keys/jwt_public.pem

# API keys (ADR-003 §6.1). sd_test_ outside production.
MERCHANT_API_KEY_PREFIX=sd_test_
MERCHANT_API_KEY_PEPPER=GENERATE
MERCHANT_API_KEY_PEPPER_VERSION=1

# Webhook signing secrets are AES-256-GCM encrypted at rest (base64 of 32 bytes).
WEBHOOK_SECRET_ENCRYPTION_KEY=GENERATE
WEBHOOK_SECRET_KEY_VERSION=1

# Local-only relaxations (config refuses them unless APP_ENV=local).
WEBHOOK_ALLOW_HTTP=true
WEBHOOK_ALLOWED_PRIVATE_HOSTS=webhook-sink

MERCHANT_MAX_ACTIVE_KEYS=5
WEBHOOK_MAX_ENDPOINTS_PER_MERCHANT=10
SHUTDOWN_DRAIN_SECONDS=2
SHUTDOWN_TIMEOUT_SECONDS=15
