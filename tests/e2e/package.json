{
  "name": "@swiftdrop/e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-module end-to-end acceptance tests for SwiftDrop",
  "scripts": {
    "test": "playwright test",
    "test:12-users": "playwright test flows/real-system-12-user-workflows.spec.ts --project=admin-portal",
    "test:12-user-workflows": "playwright test flows/real-system-12-user-workflows.spec.ts --project=admin-portal",
    "test:live": "playwright test flows/realtime-live-system.spec.ts --project=admin-portal",
    "test:live-guardrails": "playwright test flows/realtime-live-guardrails.spec.ts --project=admin-portal",
    "test:realtime": "playwright test flows/realtime-orchestration.spec.ts --project=admin-portal",
    "test:security": "playwright test flows/realtime-auth-guardrails.spec.ts --project=admin-portal",
    "test:merchant-orders": "playwright test flows/08-merchant-portal-orders.spec.ts --project=merchant-portal",
    "test:merchant-orders-edge-cases": "playwright test flows/11-merchant-orders-edge-cases.spec.ts --project=merchant-portal",
    "test:merchant-api-keys": "playwright test flows/10-merchant-api-keys-exhaustive.spec.ts --project=merchant-portal",
    "test:merchant-webhooks": "playwright test flows/09-merchant-webhook-dispatch-lifecycle.spec.ts --project=merchant-portal",
    "test:combinatorial-webhooks": "playwright test flows/combinatorial-webhooks.spec.ts --project=merchant-portal",
    "test:traffic": "playwright test flows/realtime-user-traffic-load.spec.ts --project=admin-portal",
    "test:vulnerabilities": "playwright test flows/flaw-and-vulnerability-matrix.spec.ts --project=admin-portal",
    "test:rbac-matrix": "playwright test flows/every-button-and-rbac-matrix.spec.ts --project=admin-portal",
    "test:dispatcher": "playwright test flows/12-dispatcher-portal-exhaustive.spec.ts --project=dispatcher-board",
    "test:dispatcher-sync": "playwright test flows/13-dispatcher-cross-portal-sync.spec.ts --project=dispatcher-board",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:dry-run": "playwright test flows/dry-run.spec.ts",
    "test:webhook": "npm --prefix mock-webhook test",
    "start": "npm --prefix mock-webhook start",
    "start:webhook": "npm --prefix mock-webhook start",
    "test:report": "playwright show-report artifacts/report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@types/eventsource": "^1.1.15",
    "@types/node": "^20.11.24",
    "dotenv": "^16.4.5",
    "eventsource": "^2.0.2",
    "typescript": "^5.4.2"
  }
}
