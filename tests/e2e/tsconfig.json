{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@fixtures/*": ["./fixtures/*"],
      "@helpers/*": ["./helpers/*"],
      "@flows/*": ["./flows/*"]
    }
  },
  "include": [
    "playwright.config.ts",
    "fixtures/**/*.ts",
    "helpers/**/*.ts",
    "flows/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "artifacts",
    "mock-webhook"
  ]
}
