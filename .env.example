# ==============================================================================
# SwiftDrop Unified Local Environment Configuration
# Copy this file to .env and adjust values if needed:
#   Copy-Item .env.example .env
# ==============================================================================

# Application Runtime Mode (local, staging, production)
APP_ENV=local
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
# Connection string pointing to the local dev PostgreSQL container
DATABASE_URL=postgres://swiftdrop_user:swiftdrop_password@localhost:5432/swiftdrop_db?sslmode=disable

# ------------------------------------------------------------------------------
# RabbitMQ Message Broker
# ------------------------------------------------------------------------------
# Connection string pointing to the local dev RabbitMQ container
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ------------------------------------------------------------------------------
# Security & Cryptography Keys
# ------------------------------------------------------------------------------
# 32-byte AES-256-GCM encryption key for merchant webhook secrets (64 hex characters)
WEBHOOK_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Webhook signing secret used by fake-receiver test server
WEBHOOK_SIGNING_SECRET=whsec_test_secret_for_local_merchant_123

# JWT secret for authentication
JWT_SECRET=swiftdrop-development-secret-key-change-in-production-32chars

# ------------------------------------------------------------------------------
# Email / SMTP Configuration
# ------------------------------------------------------------------------------
# Default: Local Mailpit container (view emails in browser at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_FROM_EMAIL=notifications@swiftdrop.io
SMTP_FROM_NAME=SwiftDrop Deliveries

# Optional: To send real emails to your personal inbox (e.g. Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-google-app-password
# SMTP_FROM_EMAIL=your-email@gmail.com

# ------------------------------------------------------------------------------
# Service Ports
# ------------------------------------------------------------------------------
PORT=8080                    # Core API & Swagger UI port
RELAY_PROBE_PORT=8082        # Outbox Relay metrics & health
WORKER_PROBE_PORT=8083       # Event Worker metrics & health
RECEIVER_PORT=8088           # Webhook Fake Receiver port
SWAGGER_ENABLED=true         # Enable interactive Swagger UI at /swagger/
