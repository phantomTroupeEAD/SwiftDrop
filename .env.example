# ==============================================================================
# SwiftDrop System-Wide Environment Variable Inventory (.env.example)
# Authority: docs/operations/environment-variables.md & SRS §11.1-11.3
# Owner: Member 9 (DevOps, Kubernetes & Database Coordinator)
# Note: Copy to .env for local development. Never commit production secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global & Shared Technical Settings
# ------------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=info
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost

# ------------------------------------------------------------------------------
# 2. Authoritative Persistence (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=swiftdrop_dev_password
POSTGRES_DB=swiftdrop_db
DATABASE_URL=postgres://swiftdrop:swiftdrop_dev_password@postgres:5432/swiftdrop_db?sslmode=disable
DB_MAX_OPEN_CONNS=12
DB_MAX_IDLE_CONNS=5

# Role-specific database URLs (used in Kubernetes / production via postgres-secrets)
# TRACKING_DATABASE_URL=postgres://swiftdrop_tracking_ro:swiftdrop_tracking_dev@postgres:5432/swiftdrop_db?sslmode=disable
# RELAY_DATABASE_URL=postgres://swiftdrop_relay:swiftdrop_relay_dev@postgres:5432/swiftdrop_db?sslmode=disable
# WORKER_DATABASE_URL=postgres://swiftdrop_worker:swiftdrop_worker_dev@postgres:5432/swiftdrop_db?sslmode=disable
# RECONCILER_DATABASE_URL=postgres://swiftdrop_reconciler:swiftdrop_reconciler_dev@postgres:5432/swiftdrop_db?sslmode=disable

# ------------------------------------------------------------------------------
# 3. Message Broker (RabbitMQ 3.13)
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=swiftdrop
RABBITMQ_DEFAULT_PASS=swiftdrop_dev
RABBITMQ_URL=amqp://swiftdrop:swiftdrop_dev@rabbitmq:5672/

# ------------------------------------------------------------------------------
# 4. Ephemeral Cache & Pub/Sub (Redis 7)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 5. Core API Identity & Security
# ------------------------------------------------------------------------------
JWT_SECRET=swiftdrop-development-secret-key-change-in-production-32chars
JWT_ACCESS_EXP_MINUTES=15
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=123456789-mock.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret-key
GOOGLE_REDIRECT_URI=http://localhost/api/v1/auth/google/callback
IDEMPOTENCY_EXPIRY_HOURS=24

# ------------------------------------------------------------------------------
# 6. Merchants & Webhook Cryptography
# ------------------------------------------------------------------------------
WEBHOOK_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MERCHANT_API_KEY_PEPPER=swiftdrop-merchant-pepper-secret-32-chars

# ------------------------------------------------------------------------------
# 7. Object Storage (MinIO locally / Cloudflare R2 in prod)
# ------------------------------------------------------------------------------
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=swiftdrop-pod-attachments
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
S3_ENDPOINT=http://minio:9000
S3_BUCKET=swiftdrop-pod-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ------------------------------------------------------------------------------
# 8. Tracking API Settings
# ------------------------------------------------------------------------------
TRACKING_HTTP_ADDR=:8081
SSE_HEARTBEAT_SECONDS=15

# ------------------------------------------------------------------------------
# 9. Asynchronous Messaging, Outbox Relay & Event Worker
# ------------------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_STALE_SECONDS=60
WORKER_CONCURRENCY=10
WEBHOOK_HTTP_TIMEOUT_SECONDS=5

# Notification provider backend: mock, smtp
NOTIFICATION_PROVIDER=mock
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=swiftdrop
SMTP_PASSWORD=mailpit_password
SMTP_FROM=no-reply@swiftdrop.com

# ------------------------------------------------------------------------------
# 10. AI Assistant & FastMCP Service
# ------------------------------------------------------------------------------
PORT=8000
MCP_PORT=8002
CORE_API_URL=http://core-api:8080
TRACKING_API_URL=http://tracking-api:8081
MOCK_LLM_MODE=true
USE_MOCK_UPSTREAM=true
SWIFTDROP_API_KEY=sd_live_demo_merchant_123

# ------------------------------------------------------------------------------
# 11. Web Frontend (React / Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_API_GATEWAY_URL=http://localhost/api/v1
VITE_TRACKING_SSE_URL=/api/v1/tracking/public
VITE_APP_TITLE=SwiftDrop Courier Logistics
