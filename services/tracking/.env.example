# ==============================================================================
# SwiftDrop Tracking API Service — Environment Configuration Template
# Service: services/tracking (Port :8081)
# Owner: Member 5 (Tracking API & Real-Time Updates)
# ==============================================================================
# Usage:
#   cp .env.example .env
#
# Rules:
# - NEVER commit secrets or credentials.
# - Phase 1 starts independently without database or broker connections.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HTTP Server & Runtime Environment
# ------------------------------------------------------------------------------
# Service runtime environment: local, development, test, staging, production
APP_ENV=local

# HTTP listen address (defaults to :8081)
# Can also be set via HTTP_ADDR or PORT (e.g. PORT=8081)
TRACKING_HTTP_ADDR=:8081

# Graceful shutdown deadline duration
SHUTDOWN_TIMEOUT=15s

# HTTP server timeouts
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s

# ------------------------------------------------------------------------------
# 2. Structured Logging
# ------------------------------------------------------------------------------
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 3. Future Integration Contracts (Phase 2+ — Optional in Phase 1)
# ------------------------------------------------------------------------------
# Read-Only PostgreSQL Database URL (swiftdrop_tracking_ro role)
# TRACKING_DATABASE_URL=postgres://swiftdrop_tracking_ro:swiftdrop_tracking_dev@localhost:5432/swiftdrop_db?sslmode=disable

# Redis 7 Pub/Sub URL for multi-pod fan-out
# REDIS_URL=redis://localhost:6379/0

# RabbitMQ 3.13 AMQP Broker URL for lifecycle updates ingestion
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Server-Sent Events (SSE) keepalive heartbeat interval (seconds)
SSE_HEARTBEAT_SECONDS=15

