# ==============================================================================
# SwiftDrop Messaging Service - Environment Configuration Template
# ==============================================================================
# Copy to .env for local development:
#   cp .env.example .env
#
# Rules:
# - NEVER commit secrets or credentials.
# - In production (APP_ENV=production), all secrets must be provided via Kubernetes Secrets.
# ==============================================================================

# Application Environment (local, staging, production)
APP_ENV=local

# Authoritative PostgreSQL Database URL
DATABASE_URL=postgres://swiftdrop_user:swiftdrop_password@localhost:5432/swiftdrop_db?sslmode=disable

# Dedicated Reconciler Database URL (separate connection budget)
RECONCILER_DATABASE_URL=postgres://swiftdrop_user:swiftdrop_password@localhost:5432/swiftdrop_db?sslmode=disable

# RabbitMQ AMQP Broker URL
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Transactional Outbox Polling
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_STALE_SECONDS=300
OUTBOX_LEASE_SECONDS=60

# Event Worker Concurrency
WORKER_CONCURRENCY=10
DELIVERY_LEASE_SECONDS=120

# Webhook Dispatcher
WEBHOOK_HTTP_TIMEOUT_SECONDS=5
WEBHOOK_RETRY_SCHEDULE=0s,30s,2m,10m,30m
WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# 32-byte AES-256 Secret Key in 64-character Hexadecimal format
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SMTP Email Configuration (Mailpit local defaults)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@swiftdrop.local
SMTP_FROM_NAME=SwiftDrop Delivery

# HTTP Probe & Metrics Server Port (8082 for relay, 8083 for worker)
PROBE_PORT=8082

# OpenAPI / Swagger Documentation
SWAGGER_ENABLED=true

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

