# ==============================================================================
# SwiftDrop AI Delivery Assistant & FastMCP Service — Environment Configuration
# ==============================================================================

# Server Network & Runtime Environment
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# LLM Provider Configuration (Universal OpenAI-Compatible Client)
# ------------------------------------------------------------------------------
# Default: OpenRouter. Can be changed to Groq, NVIDIA NIM, OpenAI, or Ollama.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=meta-llama/llama-3.1-70b-instruct
LLM_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# Offline CI / Automated Testing Toggle
# ------------------------------------------------------------------------------
# When 'true' (or if LLM_API_KEY is empty), the service uses the deterministic
# offline regex/fixture mock adapter. Zero external network calls or cloud API costs.
MOCK_LLM_MODE=true

# ------------------------------------------------------------------------------
# Upstream Microservice Endpoints (Internal Docker / Kubernetes DNS)
# ------------------------------------------------------------------------------
# Core API Modular Monolith (Member 2 Pricing & Parcels)
CORE_API_URL=http://core-api:8080

# Tracking Service (Member 5 Real-Time SSE & Public Milestones)
TRACKING_API_URL=http://tracking-api:8081

# ------------------------------------------------------------------------------
# Unified Mock Upstream Services Toggle (for local testing without other services)
# ------------------------------------------------------------------------------
# When 'true', routes tool HTTP calls to the local unified mock server on port 8085
# (Unallocated port chosen to eliminate collisions with Core API on 8080)
USE_MOCK_UPSTREAM=false
MOCK_UPSTREAM_PORT=8085
MOCK_CORE_API_URL=http://127.0.0.1:8085
MOCK_TRACKING_API_URL=http://127.0.0.1:8085

# ------------------------------------------------------------------------------
# Security, Tokens & Rate Limiting
# ------------------------------------------------------------------------------
# Shared HMAC-SHA256 secret key for validating Core API access tokens
JWT_SECRET=swiftdrop-development-secret-key-change-in-production-32chars

# Shared service secret for internal API calls (e.g. GET /api/v1/admin/settings)
AI_SERVICE_ROLE_TOKEN=dev-internal-secret-key-123
INTERNAL_SERVICE_KEY=dev-internal-secret-key-123

# Tiered Rate Limiting Ceilings (requests per minute)
RATE_LIMIT_ANONYMOUS_RPM=20
RATE_LIMIT_CUSTOMER_RPM=60
RATE_LIMIT_MERCHANT_RPM=100
AI_RATE_LIMIT_RPM=20

# ------------------------------------------------------------------------------
# In-Memory Conversational Session Cache (Stateless Isolation)
# ------------------------------------------------------------------------------
# Session time-to-live in minutes
AI_SESSION_TTL_MINUTES=15

# Maximum active concurrent sessions retained in memory before LRU eviction
AI_SESSION_MAX_ACTIVE=50

# Background cache expiration time for company policies in minutes
POLICY_CACHE_TTL_MINUTES=30
